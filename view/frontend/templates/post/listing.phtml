<?php

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use MageOS\Blog\ViewModel\Post\Listing as PostListing;

/** @var \MageOS\Blog\Block\Post\Listing $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var PostListing $viewModel */
$viewModel = $block->getData('view_model');
$items = $viewModel->getItems();
?>
<div class="mageos-blog mageos-blog-container">
    <?php if ($items === []): ?>
        <p class="mageos-blog-empty"><?= $escaper->escapeHtml(__('No posts yet.')); ?></p>
    <?php else: ?>
        <?= /** @noEscape */ $block->getLayout()
            ->createBlock(Template::class)
            ->setTemplate('MageOS_BlogHyva::post/cards.phtml')
            ->setData('posts', $items)
            ->setData('view_model', $viewModel)
            ->toHtml(); ?>

        <?php $totalPages = $viewModel->getTotalPages(); ?>
        <?php if ($totalPages > 1): ?>
            <?= /** @noEscape */ $block->getLayout()
                ->createBlock(Template::class)
                ->setTemplate('MageOS_BlogHyva::post/pagination.phtml')
                ->setData('view_model', $viewModel)
                ->setData('total_pages', $totalPages)
                ->toHtml(); ?>
        <?php endif; ?>
    <?php endif; ?>
</div>
