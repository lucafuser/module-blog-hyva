<?php
/**
 * Blog recent posts slider using Hyvä's custom slider functionality
 */

use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use MageOS\Blog\Block\Widget\Recent;

/** @var Recent $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

?>

<?php
$width = (int)$block->getBackgroundImageWidth() ?: 700;
$imageHelper = $this->helper(\MageOS\Blog\Helper\Image::class);
$_postCollection = $block->getPostCollection();

$sliderViewModel = $viewModels->require(\Hyva\Theme\ViewModel\Slider::class);
?>

<div class="carousel-widget-wrapper <?= $block->getData('widget_width') === 'contained' ? 'container' : '' ?>">

    <?php if ($_postCollection->count()) { ?>
        <div class="block-title-wrap">
            <h4 class="block-title font-semibold text-2xl m-0 px-2">
                <?= $block->escapeHtml($block->getTitle()) ?>
            </h4>
        </div>

        <?php
        // Create a temporary block to render each blog post
        $layout = $block->getLayout();

        // Create and prepare the slider item template
        $itemTemplateBlock = $layout->createBlock(\Magento\Framework\View\Element\Template::class);
        $itemTemplateBlock->setTemplate('MageOS_BlogHyva::blog-post-carousel-item.phtml');
        $itemTemplateBlock->setImageHelper($imageHelper);
        $itemTemplateBlock->setImageWidth($width);

        // Build the slider items array
        $sliderItems = [];
        foreach ($_postCollection as $_post) {
            $sliderItems[] = $_post;
        }

        // Create and configure the slider
        $slider = $sliderViewModel->getSliderForItems(
            'MageOS_BlogHyva::widget/slider/blog-post-carousel-item.phtml',
            $sliderItems,
            'MageOS_BlogHyva::widget/slider/slider-wrapper.phtml',
        );
        $slider->setData('max_visible', 3);
        $slider->setData('show_pagination', $block->getData('show_pagination'));
        $slider->setData('arrows_position', $block->getData('arrows_position'));
        $slider->setData('maybe_purged_tailwind_section_classes', 'my-8 text-gray-700 body-font');
        $slider->setData('maybe_purged_tailwind_slide_item_classes', 'py-1 px-2 w-full md:w-1/2 lg:w-1/3');

        // Render the slider
        echo $slider->toHtml();
    } ?>
</div>
