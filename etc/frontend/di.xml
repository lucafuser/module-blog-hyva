<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Hyva\Theme\Service\Navigation">
        <plugin name="MageOS_BlogHyva_Plugin_Hyva_Theme_Service_Navigation"
                type="MageOS\BlogHyva\Plugin\Hyva\Theme\Service\Navigation" sortOrder="1" disabled="false"/>
    </type>
    <type name="Hyva\CompatModuleFallback\Model\CompatModuleRegistry">
        <arguments>
            <argument name="compatModules" xsi:type="array">
                <item name="orig_rowebblog_map" xsi:type="array">
                    <item name="original_module" xsi:type="string">MageOS_Blog</item>
                    <item name="compat_module" xsi:type="string">MageOS_BlogHyva</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
